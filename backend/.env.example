# ── App ────────────────────────────────────────────────────
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (JWT — org students) ───────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/definam

# ── Paystack ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email — Resend (primary) ────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=no-reply@definam.ng

# ── Email — SMTP (fallback) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI APIs (future use) ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

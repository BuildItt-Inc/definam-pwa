# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Set to true in any real deployment (frontend and backend on different
# origins, e.g. Vercel + Coolify) — required for the refresh-token cookie
# to survive cross-origin requests. Leave false only for local plain-HTTP
# dev. If this is wrong in production, every user gets logged out on
# refresh with no visible error — see auth.py's _set_refresh_cookie.
COOKIE_SECURE=false

# ── Auth (JWT) ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/definam

# ── Redis (Upstash in prod, local Redis in dev) ──────────────
REDIS_URL=redis://localhost:6379

# ── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email — Resend (primary) ─────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=no-reply@definam.ng

# ── Email — SMTP (fallback) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI — Chat & content generation (Azure OpenAI / Foundry) ──
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://recall-tutor-resource.services.ai.azure.com/api/projects/recall-tutor/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_FALLBACK_DEPLOYMENT=DeepSeek-V4-Pro
AZURE_OPENAI_API_VERSION=2024-10-21

# ── AI — Embeddings (Gemini text-embedding-004) ──────────────
GEMINI_API_KEY=

# ── Push notifications (Firebase & OneSignal) ─────────────────
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

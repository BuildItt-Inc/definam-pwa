# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (JWT) ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/definam

# ── Redis (Upstash in prod, local Redis in dev) ──────────────
REDIS_URL=redis://localhost:6379

# ── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email — Resend (primary) ─────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=no-reply@definam.ng

# ── Email — SMTP (fallback) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AI — Chat & content generation (Groq / Llama-3.3-70b) ───
GROQ_API_KEY=

# ── AI — Embeddings (Gemini text-embedding-004) ──────────────
GEMINI_API_KEY=

# ── Push notifications (OneSignal) ───────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
